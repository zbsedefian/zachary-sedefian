---
interface Props {
	title: string;
	description?: string;
	level?: "h1" | "h2";
}

const { title, description, level = "h1" } = Astro.props;
const Heading = level;
---

<div class="section-header">
	<Heading>{title}</Heading>
	{description && <p class="section-header__description prose">{description}</p>}
</div>

<style>
	.section-header {
		margin-bottom: 1.5rem;
	}

	.section-header__description {
		color: var(--color-text-muted);
		margin-top: -0.4em;
	}
</style>
