---
import type { CollectionEntry } from "astro:content";

interface Props {
	entry: CollectionEntry<"courses">;
}

const { entry } = Astro.props;
const { courseNumber, title, institution, semester, syllabus } = entry.data;
---

<p class="course">
	<span class="course__title">{courseNumber}: {title}</span>
	<span class="course__meta">{institution}, {semester}</span>
	{syllabus && <a href={syllabus}>Syllabus</a>}
</p>

<style>
	.course {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1rem;
		margin: 0;
		padding-block: 0.75rem;
		border-bottom: 1px solid var(--color-border);
	}

	.course__title {
		font-weight: 600;
	}

	.course__meta {
		color: var(--color-text-muted);
	}
</style>
