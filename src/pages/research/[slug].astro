---
import { getCollection, render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Tag from "../../components/Tag.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	PUBLICATION_STATUS_LABELS,
	PUBLICATION_TYPE_LABELS,
} from "../../utils/labels";

export async function getStaticPaths() {
	const publications = await getCollection("publications");
	return publications.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, authors, journal, venue, year, status, type, abstract, doi, pdf, citation, tags } =
	entry.data;
---

<BaseLayout title={title} description={abstract}>
	<article class="container pub-detail">
		<Breadcrumbs
			items={[
				{ label: "Research", href: "/research/" },
				{ label: title },
			]}
		/>

		<p class="pub-detail__meta">
			{PUBLICATION_TYPE_LABELS[type]} &middot; {year} &middot; {PUBLICATION_STATUS_LABELS[status]}
		</p>
		<h1>{title}</h1>
		<p class="pub-detail__authors">{authors.join(", ")}</p>
		{(journal || venue) && <p class="pub-detail__venue">{journal ?? venue}</p>}

		<div class="pub-detail__links">
			{doi && <a href={`https://doi.org/${doi}`}>DOI: {doi}</a>}
			{pdf && <a href={pdf}>Download PDF</a>}
		</div>

		<h2>Abstract</h2>
		<p class="prose">{abstract}</p>

		<div class="prose pub-detail__body">
			<Content />
		</div>

		<h2>Citation</h2>
		<blockquote>{citation}</blockquote>

		{
			tags.length > 0 && (
				<ul class="pub-detail__tags">
					{tags.map((tag) => (
						<li>
							<Tag label={tag} href={`/research/?topic=${encodeURIComponent(tag)}`} />
						</li>
					))}
				</ul>
			)
		}
	</article>
</BaseLayout>

<style>
	.pub-detail {
		padding-block: 2.5rem 3rem;
		max-width: var(--content-max-width);
	}

	.pub-detail__meta {
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.pub-detail__authors {
		color: var(--color-text-muted);
		margin-top: -0.6em;
	}

	.pub-detail__venue {
		font-style: italic;
		color: var(--color-text-muted);
	}

	.pub-detail__links {
		display: flex;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.pub-detail__tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin-top: 1rem;
	}
</style>
