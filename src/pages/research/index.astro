---
import { getCollection } from "astro:content";
import PublicationCard from "../../components/PublicationCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PUBLICATION_TYPE_LABELS } from "../../utils/labels";

const publications = await getCollection("publications");
publications.sort((a, b) => b.data.year - a.data.year);

const years = [...new Set(publications.map((p) => p.data.year))].sort(
	(a, b) => b - a,
);
const statuses = [...new Set(publications.map((p) => p.data.status))];
const topics = [...new Set(publications.flatMap((p) => p.data.tags))].sort();

const typeOrder = [
	"peer-reviewed-article",
	"working-paper",
	"conference-paper",
	"book-review",
] as const;

const grouped = typeOrder
	.map((type) => ({
		type,
		label: PUBLICATION_TYPE_LABELS[type],
		items: publications.filter((p) => p.data.type === type),
	}))
	.filter((group) => group.items.length > 0);
---

<BaseLayout
	title="Research"
	description="Peer-reviewed articles, working papers, conference papers, and book reviews by Zachary Sedefian."
>
	<section class="container page-header">
		<SectionHeader
			title="Research"
			description="Peer-reviewed articles, working papers, conference papers, and book reviews."
		/>
	</section>

	<section class="container filters" aria-label="Filter publications">
		<div class="filter-group">
			<label for="filter-search">Search</label>
			<input type="search" id="filter-search" placeholder="Search titles…" />
		</div>
		<div class="filter-group">
			<label for="filter-year">Year</label>
			<select id="filter-year">
				<option value="">All years</option>
				{years.map((year) => <option value={year}>{year}</option>)}
			</select>
		</div>
		<div class="filter-group">
			<label for="filter-status">Status</label>
			<select id="filter-status">
				<option value="">All statuses</option>
				{
					statuses.map((status) => (
						<option value={status}>{status.replace("-", " ")}</option>
					))
				}
			</select>
		</div>
		<div class="filter-group">
			<label for="filter-topic">Topic</label>
			<select id="filter-topic">
				<option value="">All topics</option>
				{topics.map((topic) => <option value={topic}>{topic}</option>)}
			</select>
		</div>
	</section>

	{
		grouped.map((group) => (
			<section class="container pub-group" data-group>
				<h2>{group.label}</h2>
				<div class="pub-group__list">
					{group.items.map((entry) => (
						<PublicationCard entry={entry} />
					))}
				</div>
			</section>
		))
	}

	<p id="no-results" class="container no-results" hidden>
		No publications match the selected filters.
	</p>
</BaseLayout>

<style>
	.page-header {
		padding-top: 2.5rem;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.filter-group {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.85rem;
	}

	.filter-group label {
		color: var(--color-text-muted);
	}

	.filter-group input,
	.filter-group select {
		font: inherit;
		padding: 0.4em 0.6em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		min-width: 12rem;
		background: var(--color-bg);
		color: var(--color-text);
	}

	.pub-group {
		padding-block: 2rem;
	}

	.pub-group__list {
		max-width: var(--content-max-width);
	}

	.no-results {
		color: var(--color-text-muted);
		font-style: italic;
		padding-block: 2rem;
	}
</style>

<script>
	const searchInput = document.getElementById("filter-search") as HTMLInputElement;
	const yearSelect = document.getElementById("filter-year") as HTMLSelectElement;
	const statusSelect = document.getElementById("filter-status") as HTMLSelectElement;
	const topicSelect = document.getElementById("filter-topic") as HTMLSelectElement;
	const cards = Array.from(document.querySelectorAll<HTMLElement>(".pub-card"));
	const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));
	const noResults = document.getElementById("no-results");

	function applyFilters() {
		const query = searchInput.value.trim().toLowerCase();
		const year = yearSelect.value;
		const status = statusSelect.value;
		const topic = topicSelect.value;
		let visibleCount = 0;

		for (const card of cards) {
			const title = card.querySelector("h3")?.textContent?.toLowerCase() ?? "";
			const matchesQuery = !query || title.includes(query);
			const matchesYear = !year || card.dataset.year === year;
			const matchesStatus = !status || card.dataset.status === status;
			const matchesTopic =
				!topic || (card.dataset.tags ?? "").split(",").includes(topic);
			const visible = matchesQuery && matchesYear && matchesStatus && matchesTopic;
			card.hidden = !visible;
			if (visible) visibleCount += 1;
		}

		for (const group of groups) {
			const hasVisible = group.querySelectorAll(".pub-card:not([hidden])").length > 0;
			group.hidden = !hasVisible;
		}

		if (noResults) noResults.hidden = visibleCount !== 0;
	}

	for (const control of [searchInput, yearSelect, statusSelect, topicSelect]) {
		control?.addEventListener("input", applyFilters);
	}
</script>
