---
import SectionHeader from "../components/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, SOCIAL_LINKS } from "../data/site";

const profileLinks = SOCIAL_LINKS.filter((link) => link.icon !== "email");
---

<BaseLayout
	title="Contact"
	description="Get in touch with Zachary B. Sedefian for research inquiries, media, or teaching."
>
	<section class="container page-header">
		<SectionHeader
			title="Contact"
			description="For research inquiries, media requests, speaking engagements, or teaching-related questions, please reach out by email."
		/>
	</section>

	<section class="container contact">
		<a class="contact__email" href={`mailto:${SITE.email}`}>{SITE.email}</a>

		<h2 class="contact__subheading">Elsewhere</h2>
		<ul class="contact__links">
			{
				profileLinks.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.page-header {
		padding-top: 2.5rem;
	}

	.contact {
		max-width: var(--content-max-width);
		padding-bottom: 3rem;
	}

	.contact__email {
		display: inline-block;
		font-size: 1.3rem;
		font-family: var(--font-serif);
		color: var(--color-accent);
		text-decoration: none;
	}

	.contact__email:hover {
		color: var(--color-accent-hover);
	}

	.contact__subheading {
		margin-top: 2.5rem;
		font-size: 1.1rem;
	}

	.contact__links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.contact__links a {
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.contact__links a:hover {
		color: var(--color-accent);
	}
</style>
