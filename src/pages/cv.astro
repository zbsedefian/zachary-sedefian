---
import Button from "../components/Button.astro";
import SectionHeader from "../components/SectionHeader.astro";
import {
	ADDITIONAL_EXPERIENCE,
	EDUCATION,
	HONORS,
	LANGUAGES,
	PEER_REVIEW,
	PROFESSIONAL_EXPERIENCE,
	SKILLS,
} from "../data/cv";
import BaseLayout from "../layouts/BaseLayout.astro";

const CV_PDF_HREF = "/cv/zachary-sedefian-cv.pdf";
---

<BaseLayout
	title="Curriculum Vitae"
	description="Curriculum vitae for Zachary B. Sedefian: education, publications, teaching, and professional experience."
>
	<section class="container page-header">
		<SectionHeader title="Curriculum Vitae" />
		<Button href={CV_PDF_HREF}>Download PDF</Button>
	</section>

	<section class="container cv-section">
		<h2>Education</h2>
		<ul class="cv-list">
			{
				EDUCATION.map((entry) => (
					<li class="cv-list__item">
						<div class="cv-list__row">
							<span class="cv-list__title">
								{entry.degree}, {entry.institution}
							</span>
							<span class="cv-list__meta">{entry.year}</span>
						</div>
						{entry.detail && <p class="cv-list__detail">{entry.detail}</p>}
					</li>
				))
			}
		</ul>
	</section>

	<section class="container cv-section">
		<h2>Research &amp; Publications</h2>
		<p class="prose">
			Peer-reviewed articles, working papers, and conference presentations are listed on the <a
				href="/research/">Research page</a
			>.
		</p>
	</section>

	<section class="container cv-section">
		<h2>Teaching Experience</h2>
		<p class="prose">
			Courses taught are listed on the <a href="/teaching/">Teaching page</a>.
		</p>
	</section>

	<section class="container cv-section">
		<h2>Journalistic Publications</h2>
		<p class="prose">
			Journalism and public-facing writing are listed on the <a href="/writing/">Writing page</a>.
		</p>
	</section>

	<section class="container cv-section">
		<h2>Peer Review Activities</h2>
		<ul class="cv-bullets">
			{PEER_REVIEW.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="container cv-section">
		<h2>Professional Experience</h2>
		<ul class="cv-list">
			{
				PROFESSIONAL_EXPERIENCE.map((entry) => (
					<li class="cv-list__item">
						<div class="cv-list__row">
							<span class="cv-list__title">
								{entry.title}, {entry.organization}
								{entry.location && `, ${entry.location}`}
							</span>
							<span class="cv-list__meta">{entry.years}</span>
						</div>
						{entry.bullets && (
							<ul class="cv-bullets">
								{entry.bullets.map((bullet) => (
									<li>{bullet}</li>
								))}
							</ul>
						)}
					</li>
				))
			}
		</ul>
	</section>

	<section class="container cv-section">
		<h2>Analytical &amp; Technical Skills</h2>
		<ul class="cv-bullets">
			{SKILLS.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="container cv-section">
		<h2>Additional Research &amp; Analytical Experience</h2>
		<ul class="cv-list">
			{
				ADDITIONAL_EXPERIENCE.map((entry) => (
					<li class="cv-list__item">
						<div class="cv-list__row">
							<span class="cv-list__title">
								{entry.title}, {entry.organization}
							</span>
							<span class="cv-list__meta">{entry.years}</span>
						</div>
						{entry.bullets && (
							<ul class="cv-bullets">
								{entry.bullets.map((bullet) => (
									<li>{bullet}</li>
								))}
							</ul>
						)}
					</li>
				))
			}
		</ul>
	</section>

	<section class="container cv-section">
		<h2>Selected Honors and Awards</h2>
		<ul class="cv-list">
			{
				HONORS.map((entry) => (
					<li class="cv-list__row">
						<span class="cv-list__title">{entry.title}</span>
						<span class="cv-list__meta">{entry.year}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="container cv-section">
		<h2>Languages</h2>
		<ul class="cv-list">
			{
				LANGUAGES.map((entry) => (
					<li class="cv-list__row">
						<span class="cv-list__title">{entry.language}</span>
						<span class="cv-list__meta">{entry.level}</span>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.page-header {
		padding-top: 2.5rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.cv-section {
		padding-block: 1.75rem;
		border-top: 1px solid var(--color-border);
		max-width: var(--content-max-width);
	}

	.cv-section:last-child {
		padding-bottom: 3rem;
	}

	.cv-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.cv-list__row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.cv-list__title {
		font-weight: 600;
	}

	.cv-list__meta {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.cv-list__detail {
		margin: 0.3em 0 0;
		color: var(--color-text-muted);
	}

	.cv-bullets {
		margin: 0.5em 0 0;
		padding-left: 1.25em;
		color: var(--color-text-muted);
	}

	.cv-bullets li {
		margin-bottom: 0.3em;
	}
</style>
