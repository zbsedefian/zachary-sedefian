---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PROJECT_CATEGORY_LABELS } from "../../utils/labels";

const projects = await getCollection("projects");
projects.sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

const categoryOrder = ["research", "book", "presentation", "dataset"] as const;

const grouped = categoryOrder
	.map((category) => ({
		category,
		label: PROJECT_CATEGORY_LABELS[category],
		items: projects.filter((entry) => entry.data.category === category),
	}))
	.filter((group) => group.items.length > 0);
---

<BaseLayout
	title="Projects"
	description="Current research projects, future book projects, conference presentations, and datasets."
>
	<section class="container page-header">
		<SectionHeader
			title="Projects"
			description="Current research projects, future book projects, conference presentations, and datasets."
		/>
	</section>

	{
		grouped.map((group) => (
			<section class="container project-group">
				<h2>{group.label}</h2>
				<div class="project-group__list">
					{group.items.map((entry) => (
						<ProjectCard entry={entry} />
					))}
				</div>
			</section>
		))
	}
</BaseLayout>

<style>
	.page-header {
		padding-top: 2.5rem;
	}

	.project-group {
		padding-block: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.project-group__list {
		max-width: var(--content-max-width);
	}
</style>
