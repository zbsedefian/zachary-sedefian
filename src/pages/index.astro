---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import portrait from "../assets/images/zachary-sedefian-portrait.jpg";
import Button from "../components/Button.astro";
import NewsCard from "../components/NewsCard.astro";
import PublicationCard from "../components/PublicationCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { RESEARCH_AREAS, SITE } from "../data/site";

const publications = await getCollection("publications");
publications.sort((a, b) => b.data.year - a.data.year);
const recentPublications = publications.slice(0, 3);

const news = await getCollection("news");
news.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentNews = news.slice(0, 3);

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: SITE.author,
	url: SITE.url,
	email: `mailto:${SITE.email}`,
	jobTitle: "Adjunct Lecturer",
	description: SITE.description,
	affiliation: {
		"@type": "CollegeOrUniversity",
		name: "Brooklyn College, CUNY",
	},
	knowsAbout: RESEARCH_AREAS,
};
---

<BaseLayout title={SITE.title} jsonLd={personJsonLd}>
	<section class="container hero">
		<div class="hero__text">
			<p class="hero__eyebrow">Political Scientist &middot; Adjunct Lecturer</p>
			<h1>Zachary B. Sedefian</h1>
			<p class="hero__bio prose">
				I am a political scientist and adjunct lecturer whose research
				examines international political economy, imperialism, and the
				digital and gig economy, with a particular focus on platform labor and
				China. I hold an M.A. in Political Science from Brooklyn College,
				CUNY, and currently teach POLS 1002: Introduction to Global Politics.
			</p>
			<div class="hero__actions">
				<Button href="/cv/">Download CV</Button>
				<Button href="/contact/" variant="ghost">Get in touch</Button>
			</div>
		</div>
		<Image
			class="hero__portrait"
			src={portrait}
			alt="Portrait of Zachary B. Sedefian"
			width={320}
			height={427}
			loading="eager"
		/>
	</section>

	<section class="container section">
		<h2>Research Interests</h2>
		<ul class="tag-list">
			{RESEARCH_AREAS.map((area) => <li class="tag">{area}</li>)}
		</ul>
	</section>

	<section class="container section">
		<h2>Recent Publications</h2>
		<div class="prose">
			{recentPublications.map((entry) => <PublicationCard entry={entry} />)}
		</div>
		<a class="section__more" href="/research/">View all research &rarr;</a>
	</section>

	<section class="container section">
		<h2>Recent News</h2>
		<div class="prose">
			{recentNews.map((entry) => <NewsCard entry={entry} />)}
		</div>
		<a class="section__more" href="/news/">View all news &rarr;</a>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: 3.5rem 2.5rem;
		display: flex;
		flex-direction: row-reverse;
		align-items: flex-start;
		gap: 2.5rem;
		flex-wrap: wrap;
	}

	.hero__text {
		flex: 1 1 28rem;
	}

	.hero__portrait {
		width: 12rem;
		height: auto;
		border-radius: var(--radius);
		flex-shrink: 0;
	}

	.hero__eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.85rem;
		color: var(--color-text-muted);
		margin: 0 0 0.5rem;
	}

	.hero__bio {
		font-size: 1.1rem;
		color: var(--color-text-muted);
	}

	.hero__actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.section {
		padding-block: 1.75rem;
		border-top: 1px solid var(--color-border);
	}

	.tag-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: 0;
	}

	.tag {
		font-size: 0.85rem;
		padding: 0.3em 0.75em;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-text-muted);
	}

	.placeholder-note {
		color: var(--color-text-muted);
		font-style: italic;
	}

	.section__more {
		display: inline-block;
		margin-top: 1rem;
		font-size: 0.9rem;
	}
</style>
