---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import portrait from "../assets/images/zachary-sedefian-portrait.jpg";
import Button from "../components/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CV_PDF_HREF, RESEARCH_AREAS, SCHOLAR_URL, SITE } from "../data/site";
import { formatDate } from "../utils/dates";

const news = await getCollection("news");
news.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const newsItems = await Promise.all(
	news.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: SITE.author,
	url: SITE.url,
	email: `mailto:${SITE.email}`,
	jobTitle: "Lecturer in Political Science",
	description: SITE.description,
	affiliation: {
		"@type": "CollegeOrUniversity",
		name: "Brooklyn College, CUNY",
	},
	knowsAbout: RESEARCH_AREAS,
};
---

<BaseLayout title={SITE.title} jsonLd={personJsonLd}>
	<section class="container hero">
		<div class="hero__text">
			<p class="hero__eyebrow">Political Economist &middot; Lecturer</p>
			<h1>Zachary Sedefian</h1>
			<p class="hero__bio prose">
				Zachary Sedefian is a lecturer in Political Science at Brooklyn
				College, CUNY, where he earned his MA. He holds BAs in Computer
				Science, Linguistics, and Anthropology from the University at Albany,
				SUNY. He is Associate Editor of the <em>Journal of Labor and
				Society</em> and has published research in international and
				comparative political economy with a focus on the interplay between
				imperialism, technology, war, and platform labor. He also writes for <em>CovertAction
				Magazine</em>. Previously, he worked as a software
				engineer on platform systems, autonomous vehicles, and automation, and
				as an English teacher in China.
			</p>
			<div class="hero__actions">
				<Button href={CV_PDF_HREF}>CV</Button>
				<Button href={SCHOLAR_URL} variant="ghost">Google Scholar</Button>
			</div>
		</div>
		<Image
			class="hero__portrait"
			src={portrait}
			alt="Portrait of Zachary Sedefian"
			width={320}
			height={427}
			loading="eager"
		/>
	</section>

	<section class="container section">
		<h2>News</h2>
		<ul class="news">
			{
				newsItems.map(({ entry, Content }) => (
					<li class="news__item">
						<time class="news__date" datetime={entry.data.date.toISOString().slice(0, 10)}>
							{formatDate(entry.data.date, { year: "numeric", month: "short" })}
						</time>
						<div class="news__text">
							<Content />
						</div>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: 3.5rem 2.5rem;
		display: flex;
		flex-direction: row-reverse;
		align-items: flex-start;
		gap: 2.5rem;
		flex-wrap: wrap;
	}

	.hero__text {
		flex: 1 1 28rem;
	}

	.hero__portrait {
		width: 12rem;
		height: auto;
		border-radius: var(--radius);
		flex-shrink: 0;
	}

	.hero__eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.85rem;
		color: var(--color-text-muted);
		margin: 0 0 0.5rem;
	}

	.hero__bio {
		font-size: 1.1rem;
		color: var(--color-text-muted);
	}

	.hero__actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.section {
		padding-block: 1.75rem;
		border-top: 1px solid var(--color-border);
	}

	.news {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: var(--content-max-width);
	}

	.news__item {
		display: flex;
		gap: 1.25rem;
		padding-block: 0.5rem;
	}

	.news__date {
		flex: 0 0 5.5rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		padding-top: 0.1em;
	}

	.news__text :global(p) {
		margin: 0;
	}
</style>
